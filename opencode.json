{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "studio-plan",
  "instructions": [".opencode/control/GLOBAL_RULES.md"],

  "agent": {
    "route-review-expert": {
      "model": "openai/gpt-5.6-sol"
    }
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11628/v1"
      },
      "models": {
        "gemma4-12b-16k:latest": {
          "name": "Gemma 4 12B 16K Local",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },

  "permission": {
    "external_directory": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cd *": "deny",
      "Set-Location *": "deny",
      "pushd *": "deny",
      "git -C *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git commit *": "deny",
      "git push *": "deny"
    }
  }
}
