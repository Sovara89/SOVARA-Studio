{
  "name": "sovara-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "pnpm build \u0026\u0026 vitest run --config vitest.integration.config.ts",
    "build": "pnpm -r run build",
    "dev:web": "pnpm --filter @sovara-studio/web dev",
    "dev:api": "pnpm --filter @sovara-studio/api dev",
    "dev:worker": "pnpm --filter @sovara-studio/worker dev",
    "auth:schema:check": "node scripts/check-better-auth-schema.mjs",
    "db:migrate": "node packages/db/dist/migrate.js",
    "user:provision": "node apps/api/dist/commands/provision-user.js",
    "web:bundle:check": "node apps/web/scripts/check-web-bundle.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "auth": "1.7.2",
    "better-auth": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
